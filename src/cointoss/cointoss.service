# systemd --user unit for a cointoss instance.
#
# A template: `cointoss init --systemd` fills in $bin_dir (the virtualenv's bin directory,
# e.g. /home/me/cointoss/.venv/bin) and $data_dir, and installs the result as
# ~/.config/systemd/user/cointoss.service.

[Unit]
Description=cointoss: daily CoinGecko sweep and JSON-RPC API on woodglue
Documentation=https://github.com/walnutgeek/cointoss

[Service]
Type=simple
Environment=COINTOSS_HOME=$data_dir
Environment=PYTHONUNBUFFERED=1
# `wgl start` runs in the foreground. A sweep missed while it was down fires once on start.
ExecStart=$bin_dir/wgl --data=$data_dir start
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
